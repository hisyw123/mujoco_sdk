+def simulator_contract(opts):
+    """Record the actual compiled model, CSV joint mapping, and gains, not just a path."""
+    with tempfile.TemporaryDirectory() as tmp:
+        output=pathlib.Path(tmp)/'inspect.json'
+        cmd=[str(BIN),'inspect','-',str(output),'--urdf',str(opts['urdf'])]
+        for key in ['kp','kd','joint_config']:
+            if opts.get(key) is not None:
+                cmd += ['--'+key.replace('_','-'),str(opts[key])]
+        subprocess.run(cmd,check=True,stdout=subprocess.DEVNULL)
+        result=json.loads(output.read_text())
+        result['compiled_model_sha256']=hashlib.sha256(pathlib.Path(str(output)+'.mjb').read_bytes()).hexdigest()
+        return result
+
+
+def check_log_metadata(path, contract):
+    meta_path = pathlib.Path(path).with_suffix('.meta.json')
+    if not meta_path.exists():
+        print(f'NOTE: {path}: no collection metadata; verify CSV order and gains manually')
+        return
+    meta = json.loads(meta_path.read_text())
+    for key in ('joint_names', 'kp', 'kd'):
+        if meta[key] != contract[key]:
+            raise ValueError(f'{path}: collection {key} differs from replay settings')
+    if meta['csv_sha256'] != hashlib.sha256(pathlib.Path(path).read_bytes()).hexdigest():
+        raise ValueError(f'{path}: CSV changed after collection')
 
 
