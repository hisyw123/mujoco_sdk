<?xml version='1.0' encoding='utf-8'?>

<robot name="RoughTerrain-3">

  <!-- Generated from latest CAD export table. RHR/RAP masses corrected to match heavier left counterparts. L_gripper_J mimics R_gripper_J (multiplier=1.0, offset=0.0). arm3 inertia off-diagonal signs corrected from CAD principal-inertia validation. OAK-D Pro W mechanical/optical sensor frames added under camera_link. -->

  <link name="base_link">

    <inertial>

      <origin xyz="-0.011728 -0.001196 0.006697" rpy="0 0 0" />

      <mass value="17.401768" />

      <inertia ixx="0.555977" ixy="-0.001306" ixz="-0.004346" iyy="0.439224" iyz="-0.001545" izz="0.194049" />

    </inertial>

    <visual>

      <origin xyz="0 0 0" rpy="0 0 0" />

      <geometry>

        <mesh filename="../meshes/base_link.STL" />

      </geometry>

      <material name="base_link_material">

        <color rgba="0.52941 0.52157 0.44314 1" />

      </material>

    </visual>

    <!-- <collision>

      <origin xyz="0 0 0" rpy="0 0 0" />

      <geometry>

        <mesh filename="../meshes/base_link.STL" />

      </geometry>

    </collision> -->

    <collision>

      <origin xyz="0.0 0 0.00" rpy="0 0 0"/>

      <geometry>

        <box size="0.160 0.30 0.280"/>

      </geometry>

    </collision>

  </link>

  <link name="camera_link">

    <inertial>

      <origin xyz="3.4135e-05 0.083853 0.036365" rpy="0 0 0" />

      <mass value="0.067508" />

      <inertia ixx="0.000144" ixy="1e-06" ixz="0" iyy="1.5e-05" iyz="-1e-06" izz="0.000138" />

    </inertial>

    <visual>

      <origin xyz="0 0 0" rpy="0 0 0" />

      <geometry>

        <mesh filename="../meshes/camera_link.STL" />

      </geometry>

      <material name="camera_link_material">

        <color rgba="0.89412 0.89412 0.89412 1" />

      </material>

    </visual>

    <!-- <collision>

      <origin xyz="0 0 0" rpy="0 0 0" />

      <geometry>

        <mesh filename="../meshes/camera_link.STL" />

      </geometry>

    </collision> -->

  </link>

  <!-- OAK-D Pro W sensor reference frames.
       CAM_A = OV9782 center RGB, CAM_B = OV9282 left mono, CAM_C = OV9282 right mono.
       oak_mount_frame origin is the midpoint of the two 75 mm rear mounting holes.
       cam_a_mechanical_frame position comes from the DM9098 CAD registration;
       cam_a_optical_frame uses the DepthAI/OpenCV RDF optical convention (+X right, +Y down, +Z forward).
       At CAM_J=0: +X_opt=+Y_base, +Y_opt=-X_base, +Z_opt=+Z_base. -->
  <link name="oak_mount_frame"/>
  <link name="cam_a_mechanical_frame"/>
  <link name="cam_a_optical_frame"/>
  <!-- Isaac/USD/OpenGL camera frame for RGB learning.
       OpenGL camera convention: +X right, +Y up, -Z forward.
       Therefore this frame is Rx(pi) from the ROS/DepthAI optical frame.
       At CAM_J=0 its -Z axis points along +Z_base, i.e. the physical lens/view direction. -->
  <link name="cam_a_isaac_opengl_frame"/>
  <link name="cam_b_optical_frame"/>
  <link name="cam_c_optical_frame"/>

