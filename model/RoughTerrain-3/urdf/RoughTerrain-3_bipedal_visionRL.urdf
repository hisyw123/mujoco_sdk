  <!-- OAK-D Pro W mounting and calibrated optical frames.
       camera_link -> oak_mount_frame is derived from the SolidWorks mounting-hole midpoint.
       CAM_B/C relative optical poses are factory EEPROM calibration, represented as URDF parent->child poses. -->
  <joint name="oak_mount_joint" type="fixed">
    <parent link="camera_link" />
    <child link="oak_mount_frame" />
    <origin xyz="0 0.085 0.035" rpy="3.141592654 0 1.570796327" />
  </joint>

  <joint name="cam_a_mechanical_joint" type="fixed">
    <parent link="oak_mount_frame" />
    <child link="cam_a_mechanical_frame" />
    <origin xyz="-0.000001271 -0.004754419 -0.014900899" rpy="0 0 0" />
  </joint>

  <joint name="cam_a_optical_joint" type="fixed">
    <parent link="cam_a_mechanical_frame" />
    <child link="cam_a_optical_frame" />
    <origin xyz="0 0 0" rpy="3.141592654 0 0" />
  </joint>

  <!-- RGB learning / Isaac Sim USD camera frame.
       Parent cam_a_optical_frame is ROS/DepthAI optical: +X right, +Y down, +Z forward.
       Child is OpenGL/USD: +X right, +Y up, -Z forward. -->
  <joint name="cam_a_isaac_opengl_joint" type="fixed">
