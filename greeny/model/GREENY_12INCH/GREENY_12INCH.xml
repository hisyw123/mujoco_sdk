<?xml version='1.0' encoding='UTF-8'?>
<mujoco model="GREENY_12INCH_URDF_SYNCED">

  <!--
    Coordinate convention:
      +X forward
      +Y left
      +Z up

    Joint / actuator / controller order:
      0 LHY_J
      1 LHP_J
      2 LKP_J
      3 LWP_J
      4 RHY_J
      5 RHP_J
      6 RKP_J
      7 RWP_J

    Base:
      visual    = box primitive
      collision = box primitive
      base STL  = disabled

    Leg links:
      visual    = STL mesh
      collision = STL mesh

    Wheels:
      visual    = STL mesh
      collision = cylinder primitive

    Ground:
      ground_visual    = visible checker plane
      ground_collision = invisible physical plane
  -->


  <!-- ============================================================ -->
  <!-- Compiler / statistics                                        -->
  <!-- ============================================================ -->

  <compiler angle="radian"
            inertiafromgeom="false"
            meshdir="."/>

  <statistic center="0 0 0.35"
             extent="1.2"/>

  <size njmax="1000"
        nconmax="300"/>


  <!-- ============================================================ -->
  <!-- Simulation                                                    -->
  <!-- ============================================================ -->

  <option timestep="0.0005"
          gravity="0 0 -9.81"
          integrator="implicitfast"
          solver="Newton"
          iterations="150"
          tolerance="1e-10">

    <!-- Use the pre-native convex collision path to match MuJoCo 3.2.2 more
         closely.  Disabling islands also removes a solver-path difference
         introduced after 3.2.2. -->
    <flag contact="enable"
          gravity="enable"
          nativeccd="disable"
          island="disable"/>

  </option>


  <!-- ============================================================ -->
  <!-- Defaults                                                      -->
  <!-- ============================================================ -->

  <default>

    <joint damping="0.0"
           armature="0.02"
           frictionloss="0.1"/>

    <motor ctrllimited="true"
           ctrlrange="-90.8 90.8"/>

    <default class="visualgeom">
      <geom contype="0"
            conaffinity="0"
            group="1"
            density="0"
            material="robot_visual"/>
    </default>

    <default class="contactgeom">
      <geom contype="1"
            conaffinity="1"
            group="3"
            condim="3"
            friction="1.0 0.01 0.001"
            solref="0.001 1"
            solimp="0.99 0.999 0.0005"/>
    </default>

  </default>


  <!-- ============================================================ -->
  <!-- Viewer                                                        -->
  <!-- ============================================================ -->

  <visual>

      <global azimuth="135"
            elevation="-20"
            fovy="42"/>

      <headlight ambient="0.60 0.60 0.60"
                  diffuse="0.90 0.90 0.90"
                  specular="0.25 0.25 0.25"/>

      <quality shadowsize="4096"
            offsamples="4"/>

      <!-- 추가 -->
      <map force="0.001"/>

      <rgba haze="0.22 0.26 0.32 1"
            com="0.502 1.0 0 0.5"
            contactpoint="1.0 1.0 0.6 0.5"
            contactforce="0.2 0.98 0.2 0.8"/>

      <scale com="0.15"
            forcewidth="0.025"
            contactwidth="0.08"
            contactheight="0.03"/>

      </visual>


  <!-- ============================================================ -->
  <!-- Assets                                                        -->
  <!-- ============================================================ -->

  <asset>

    <!-- Bright sky/background -->
    <texture name="skybox"
             type="skybox"
             builtin="gradient"
             rgb1="0.55 0.68 0.82"
             rgb2="0.22 0.26 0.32"
             width="512"
             height="3072"/>

    <!-- Base STL intentionally disabled -->
    <!--
    <mesh name="base_link_mesh"
          file="meshes/base_link.STL"/>
    -->

    <mesh name="LHY_fix_mesh"
          file="meshes/LHY_fix.STL"/>

    <mesh name="LHY_mesh"
          file="meshes/LHY.STL"/>

    <mesh name="LHP_mesh"
          file="meshes/LHP.STL"/>

    <mesh name="LKP_mesh"
          file="meshes/LKP.STL"/>

    <mesh name="LWP_mesh"
          file="meshes/LWP.STL"/>

    <mesh name="RHY_fix_mesh"
          file="meshes/RHY_fix.STL"/>

    <mesh name="RHY_mesh"
          file="meshes/RHY.STL"/>

    <mesh name="RHP_mesh"
          file="meshes/RHP.STL"/>

    <mesh name="RKP_mesh"
          file="meshes/RKP.STL"/>

    <mesh name="RWP_mesh"
          file="meshes/RWP.STL"/>


    <!-- Ground texture -->
    <texture name="ground_tex"
             type="2d"
             builtin="checker"
             rgb1="0.32 0.35 0.40"
             rgb2="0.72 0.75 0.80"
             mark="edge"
             markrgb="0.90 0.90 0.90"
             width="512"
             height="512"/>

    <material name="ground_mat"
              texture="ground_tex"
              texrepeat="8 8"
              texuniform="true"
              reflectance="0.08"
              specular="0.10"
              shininess="0.15"/>


    <!-- Robot materials -->
    <material name="robot_visual"
              rgba="0.72 0.78 0.86 1"
              specular="0.45"
              shininess="0.65"
              reflectance="0.12"/>

    <material name="hip_visual"
              rgba="0.72 0.82 0.98 1"
              specular="0.40"
              shininess="0.60"
              reflectance="0.10"/>

    <material name="leg_visual"
              rgba="0.28 0.82 0.40 1"
              specular="0.35"
              shininess="0.55"
              reflectance="0.08"/>

    <material name="wheel_visual"
              rgba="0.035 0.035 0.040 1"
              specular="0.28"
              shininess="0.35"
              reflectance="0.04"/>

    <material name="base_visual_material"
              rgba="0.42 0.48 0.58 1"
              specular="0.40"
              shininess="0.55"
              reflectance="0.10"/>

    <hfield name="campus_terrain" file="campus_heightmap.png" size="50 50 1.5 0.1"/>

    <!-- 새로 추가할 아스팔트 재질 -->
    <material name="asphalt_mat"
            rgba="0.08 0.08 0.085 1"
            specular="0.05"
            shininess="0.05"
            reflectance="0.02"/>

  </asset>


